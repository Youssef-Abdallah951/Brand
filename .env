# Supabase — REQUIRED for checkout + order tracking (Supabase is the only order store)
VITE_SUPABASE_URL=https://edtxfquerhhjwvolnfdg.supabase.co

# ⚠️  IMPORTANT: Use the JWT anon key (starts with "eyJ..."), NOT the "publishable key".
# The "sb_publishable_..." format is NOT accepted by PostgREST and causes:
#   {"message":"No API key found in request","hint":"No `apikey` request header..."}
#
# Get your JWT anon key from:
#   Supabase Dashboard → Project Settings → API → Project API keys → anon / public
#   (It should start with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
#
VITE_SUPABASE_ANON_KEY=sb_publishable_FIifnLi_qjdIDNe57E2I5g_iwebiIlj

# Admin WhatsApp (contact only, NOT auth) is centralized in src/lib/siteConfig.ts
# Track-order Edge Function deploy (service-role key NEVER goes in frontend):
#   supabase functions deploy track-order --no-verify-jwt
#   supabase secrets set SUPABASE_URL=https://edtxfquerhhjwvolnfdg.supabase.co SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Then run supabase/migration-cod-tracking.sql AND supabase/migration-fix-checkout.sql in SQL Editor.
